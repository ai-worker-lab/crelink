{
  "id": "crelink",
  "name": "crelink",
  "category": "Product",
  "description": "crelink 서비스의 디자인 시스템. 값은 packages/design-tokens/src/tokens.json에서 생성합니다.",
  "tokens": {
    "--bg": "{color.background.screen}",
    "--surface": "{color.surface.default}",
    "--surface-warm": "{color.surface.raised}",
    "--fg": "{color.text.primary}",
    "--fg-2": "{color.text.secondary}",
    "--muted": "{color.text.subtle}",
    "--meta": "{color.text.subtle}",
    "--border": "{color.border.default}",
    "--border-soft": "{color.border.frame}",
    "--accent": "{color.action.primary}",
    "--accent-on": "{color.text.on-action}",
    "--accent-hover": "{color.action.primary-pressed}",
    "--accent-active": "{color.action.primary-pressed}",
    "--success": "{color.status.positive}",
    "--warn": "{color.status.warning}",
    "--danger": "{color.status.danger}",
    "--font-display": "{font.sans}",
    "--font-body": "{font.sans}",
    "--font-mono": "{font.mono}",
    "--text-xs": "{font.size.11}",
    "--text-sm": "{font.size.13}",
    "--text-base": "{font.size.15}",
    "--text-lg": "{font.size.18}",
    "--text-xl": "{font.size.22}",
    "--text-2xl": "{font.size.27}",
    "--text-3xl": "{font.size.38}",
    "--text-4xl": "{font.size.64}",
    "--leading-body": "1.65",
    "--leading-tight": "1.15",
    "--tracking-display": "0",
    "--space-1": "{space.4}",
    "--space-2": "{space.8}",
    "--space-3": "{space.12}",
    "--space-4": "{space.16}",
    "--space-5": "{space.20}",
    "--space-6": "{space.24}",
    "--space-8": "{space.32}",
    "--space-12": "{space.48}",
    "--section-y-desktop": "{space.48}",
    "--section-y-tablet": "{space.40}",
    "--section-y-phone": "{space.32}",
    "--radius-sm": "{corner.sm}",
    "--radius-md": "{corner.md}",
    "--radius-lg": "{corner.md}",
    "--radius-pill": "9999px",
    "--elev-flat": "none",
    "--elev-ring": "0 0 0 1px var(--border)",
    "--elev-raised": "0 8px 24px {color.overlay.shadow}",
    "--focus-ring": "0 0 0 3px var(--accent)",
    "--motion-fast": "150ms",
    "--motion-base": "200ms",
    "--ease-standard": "cubic-bezier(0.23, 1, 0.32, 1)",
    "--container-max": "1060px",
    "--container-gutter-desktop": "{space.32}",
    "--container-gutter-tablet": "{space.24}",
    "--container-gutter-phone": "{space.16}"
  }
}
