# API는 src/instrument.ts(가장 먼저)와 database.ts에서 apps/api/.env를 로드합니다. 실행 환경의 환경변수가 파일 값보다 우선합니다.
# 빈 값은 pnpm instance(또는 make up)가 이 파일로 apps/api/.env를 만들 때 이 checkout 인스턴스 값으로 채웁니다(pnpm instance --print-env).
# 키 설명: apps/api/docs/README.md#환경변수
# 형식: postgresql://<사용자>:<비밀번호>@127.0.0.1:<PostgreSQL 포트>/<DB 이름>
DATABASE_URL=
# 형식: <API 포트>
PORT=
# 본 도메인(웹) 주소. 랜딩 302 대상·이미지 주소·구글 리디렉션 URI의 기준입니다. 필수. 형식: http://127.0.0.1:<웹 포트>
WEB_URL=
# 단축 도메인 주소. 로컬은 API 주소(같은 프로세스가 /api 밖 GET /{slug}, GET /c/{id}를 처리). 필수. 형식: http://127.0.0.1:<API 포트>
SHORT_LINK_BASE_URL=
# 구글 OAuth 웹 클라이언트(사용자가 Google Cloud 콘솔에서 발급해 채움). 둘 중 하나라도 비면 로그인 API는 503 auth_not_configured.
# 콘솔의 승인된 리디렉션 URI: {WEB_URL}/auth/google/callback (로컬 예: http://127.0.0.1:5193/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영자로 로그인할 구글 이메일(쉼표 구분). 구글이 검증한 이메일만 운영자가 되며, 목록에서 빼면 다음 로그인 때 creator로 돌아갑니다.
OPERATOR_EMAILS=
# 업로드 이미지 저장소: disk(기본, UPLOAD_DIR) | s3(S3 호환 저장소, 아래 S3_*). 로컬 개발은 비워 둡니다(disk).
FILE_STORAGE=
# 업로드 이미지 저장 디렉터리(FILE_STORAGE=disk). 비우면 저장소 루트 .local/uploads(git 제외).
UPLOAD_DIR=
# FILE_STORAGE=s3일 때: path-style 엔드포인트(예: https://s3.shaul.kr), 지역(비우면 us-east-1), 버킷, 버킷 범위 자격 증명(비밀).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# DB-IP Lite City 등 mmdb 파일 경로(선택). 비우면 방문·클릭의 국가·도시를 비워 두고 기동 시 경고 로그를 한 번 남깁니다.
GEOIP_MMDB_PATH=
# 앞단의 신뢰할 리버스 프록시 수(0 이상의 정수). 0(기본)이면 소켓 주소, N이면 X-Forwarded-For의 오른쪽에서 N번째 값을 방문·클릭 IP로 씁니다. 운영(Caddy 뒤)은 1.
TRUSTED_PROXY_HOPS=
# DB TLS: disable | require | verify-full. 비우면 DATABASE_URL을 그대로 씁니다(로컬). 값이 있으면 URL의 sslmode 등은 무시합니다. 운영(Supabase)은 verify-full.
DATABASE_SSL=
# DATABASE_SSL=verify-full일 때 서버 인증서를 확인할 CA(PEM) 파일 경로(Supabase 대시보드에서 받은 루트 인증서). 비우면 Node 기본 신뢰 저장소.
DATABASE_SSL_CA_PATH=
# pg Pool 최대 연결 수(1 이상의 정수). 비우면 15. 운영(Supavisor 세션 모드)은 2 × 이 값 ≤ Supabase Pool Size − 2가 되게 정합니다(무중단 전환 중 구·신 API가 함께 돎).
# 산정 기준: apps/api/docs/README.md#db-연결-수
DATABASE_POOL_MAX=
# Sentry 오류·성능 모니터링(선택). DSN이 비면 Sentry를 켜지 않습니다(로컬 기본). 설명: apps/api/docs/README.md#오류-모니터링
# 로컬에서 전송을 확인하려면 가짜 수신 서버 주소를 넣습니다(예: http://public@127.0.0.1:<포트>/1). 운영 값은 서버 SOPS 암호문에만 둡니다.
SENTRY_DSN=
# 이벤트 환경 이름. 비우면 NODE_ENV=production이면 production, 아니면 development.
SENTRY_ENVIRONMENT=
# release(소스맵과 맞추는 값). 운영 이미지는 빌드 인자로 배포 커밋 SHA가 들어갑니다. 로컬은 비워 둡니다.
SENTRY_RELEASE=
# 성능 추적 비율(0~1). 비우면 0.1. 범위를 벗어나면 기동 거부.
SENTRY_TRACES_SAMPLE_RATE=
