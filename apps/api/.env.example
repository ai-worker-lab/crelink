# API는 main.ts와 database.ts에서 apps/api/.env를 로드합니다. 실행 환경의 환경변수가 파일 값보다 우선합니다.
# 빈 값은 pnpm instance(또는 make up)가 이 파일로 apps/api/.env를 만들 때 이 checkout 인스턴스 값으로 채웁니다(pnpm instance --print-env).
# 키 설명: apps/api/docs/README.md#환경변수
# 형식: postgresql://<사용자>:<비밀번호>@127.0.0.1:<PostgreSQL 포트>/<DB 이름>
DATABASE_URL=
# 형식: <API 포트>
PORT=
# 본 도메인(웹) 주소. 랜딩 302 대상·이미지 주소·구글 리디렉션 URI의 기준입니다. 필수. 형식: http://127.0.0.1:<웹 포트>
WEB_URL=
# 단축 도메인 주소. 로컬은 API 주소(같은 프로세스가 /api 밖 GET /{slug}, GET /c/{id}를 처리). 필수. 형식: http://127.0.0.1:<API 포트>
SHORT_LINK_BASE_URL=
# 구글 OAuth 웹 클라이언트(사용자가 Google Cloud 콘솔에서 발급해 채움). 둘 중 하나라도 비면 로그인 API는 503 auth_not_configured.
# 콘솔의 승인된 리디렉션 URI: {WEB_URL}/auth/google/callback (로컬 예: http://127.0.0.1:5193/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영자로 로그인할 구글 이메일(쉼표 구분). 구글이 검증한 이메일만 운영자가 되며, 목록에서 빼면 다음 로그인 때 creator로 돌아갑니다.
OPERATOR_EMAILS=
# 업로드 이미지 저장 디렉터리. 비우면 저장소 루트 .local/uploads(git 제외).
UPLOAD_DIR=
# DB-IP Lite City 등 mmdb 파일 경로(선택). 비우면 방문·클릭의 국가·도시를 비워 두고 기동 시 경고 로그를 한 번 남깁니다.
GEOIP_MMDB_PATH=
