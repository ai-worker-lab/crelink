{
  "name": "@crelink/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --port $EXPO_PORT",
    "android": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --android --port $EXPO_PORT",
    "ios": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --ios --port $EXPO_PORT",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crelink/design-tokens": "workspace:*",
    "@crelink/shared": "workspace:*",
    "expo": "~54.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.2"
  }
}
