{
  "name": "@crelink/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --port $EXPO_PORT",
    "android": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --android --port $EXPO_PORT",
    "ios": "EXPO_PORT=${EXPO_PORT:-$(node ../../scripts/instance.mjs --get EXPO_PORT)} && expo start --ios --port $EXPO_PORT",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crelink/design-tokens": "workspace:*",
    "@crelink/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
