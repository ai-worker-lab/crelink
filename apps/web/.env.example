# Nest API origin. 서버 전용: BFF, Server Component, /auth/google route handler가 씁니다.
# 빈 값은 pnpm instance(또는 make up)가 이 파일로 apps/web/.env.local을 만들 때 이 checkout 인스턴스 값으로 채웁니다.
# 형식: http://127.0.0.1:<API 포트> (운영은 같은 색 api의 내부 주소 http://api-<색>:3000, apps/web/README.md의 운영 컨테이너 이미지)
API_INTERNAL_URL=

# API 앞단이 /api/* 요청에 요구하는 내부 토큰(선택). 서버 전용 비밀값이라 NEXT_PUBLIC_를 붙이지 않습니다. 운영(내부 네트워크)은 쓰지 않습니다.
# 값이 있으면 웹이 API로 보내는 서버 측 요청마다 X-Crelink-Internal 헤더로 붙입니다. 로컬은 비워 둡니다(헤더 없음).
API_INTERNAL_TOKEN=

# Sentry DSN(선택, 공개 값). 서버·브라우저가 함께 쓰며 next dev·next build 때 번들에 들어갑니다. 비우면 Sentry를 켜지 않습니다(로컬 기본).
# 로컬에서 전송을 확인하려면 가짜 수신 서버 주소를 넣습니다(예: http://public@127.0.0.1:<포트>/2). 운영은 이미지 빌드 인자(vars.SENTRY_WEB_DSN)입니다.
# 소스맵 업로드 값(SENTRY_RELEASE·SENTRY_ORG·SENTRY_PROJECT, 토큰 SENTRY_AUTH_TOKEN)은 이미지 빌드에서만 씁니다. 이 파일에 토큰을 넣지 않습니다.
# 설명: apps/web/README.md#오류-모니터링
NEXT_PUBLIC_SENTRY_DSN=
