{
  "name": "@crelink/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "WEB_PORT=${WEB_PORT:-$(node ../../scripts/instance.mjs --get WEB_PORT)} && NEXT_DIST_DIR=.next-dev next dev --port $WEB_PORT",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@crelink/design-tokens": "workspace:*",
    "@crelink/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "^15.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "typescript": "~5.9.2"
  }
}
