# 로컬 개발 전용 값입니다. 프로덕션에서 재사용하지 마세요.
POSTGRES_DB=crelink
POSTGRES_USER=crelink
POSTGRES_PASSWORD=crelink-local-only
# 아래 다섯 포트는 주 checkout(슬롯 0) 포트의 유일한 원본입니다. pnpm instance(scripts/lib/instance.mjs)가 이 추적 파일에서 읽고,
# 연결된 worktree는 슬롯마다 100씩 더합니다. 포트를 바꾸려면 이 파일만 고친 뒤 pnpm instance로 확인합니다.
# Compose(compose.yaml)는 POSTGRES_PORT·VALKEY_PORT만 쓰고 API·웹·Expo 포트는 쓰지 않습니다.
API_PORT=3020
WEB_PORT=5193
EXPO_PORT=8101
POSTGRES_PORT=5452
VALKEY_PORT=6399
