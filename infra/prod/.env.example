# 서버 /opt/crelink/.env 형식(Git 제외, 권한 600, deploy 사용자 소유). 실제 값은 저장소에 두지 않습니다.
# 키 설명 원본: docs/specs/crelink-prod-deploy.md "환경변수", API 키 의미: apps/api/docs/README.md#환경변수. 절차: infra/docs/prod-runbook.md
# 크리링 공개 호스트·내부 토큰(CRELINK_DOMAIN·CRELINK_INTERNAL_TOKEN)은 edge Caddy 값이라 /opt/edge/.env에 둡니다(edge/.env.example).

# API 이미지. deploy.sh·rollback.sh가 바꾸며 바꾸기 전 값은 releases.log에 남습니다. 손으로 고치지 않습니다.
API_IMAGE=ghcr.io/ai-worker-lab/crelink-api:REPLACE_WITH_SHA

# Supabase 세션 풀러(Supavisor session mode, 포트 5432) 연결 문자열. 6543(트랜잭션 모드)은 migration advisory lock 때문에 쓰지 않습니다.
# 형식: postgresql://postgres.<프로젝트 ref>:<DB 비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# disable|require|verify-full. 운영은 verify-full + CA 파일(/opt/crelink/certs에 두면 컨테이너 /etc/crelink/certs에 보임).
DATABASE_SSL=verify-full
DATABASE_SSL_CA_PATH=/etc/crelink/certs/supabase-ca.crt

# 컨테이너 안 포트. edge Caddy가 crelink-api:3000으로 접근합니다.
PORT=3000
WEB_URL=https://links.shaul.kr
SHORT_LINK_BASE_URL=https://go.shaul.kr

# Google Cloud 콘솔 OAuth 웹 클라이언트. 승인된 리디렉션 URI: https://links.shaul.kr/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영자 구글 이메일(쉼표 구분)
OPERATOR_EMAILS=

# 볼륨 경로(compose.yaml의 uploads·geoip 볼륨). geoip 파일은 geoip.sh가 받습니다.
UPLOAD_DIR=/data/uploads
GEOIP_MMDB_PATH=/data/geoip/dbip-city-lite.mmdb

# edge Caddy 한 단을 거치므로 1. X-Forwarded-For의 마지막 값(Caddy가 쓴 접속 주소)을 방문자 IP로 씁니다.
TRUSTED_PROXY_HOPS=1
