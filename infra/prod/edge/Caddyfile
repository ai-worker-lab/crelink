# 서버 공용 edge Caddy 설정. 사이트는 sites/*.caddy 한 파일에 하나씩 두고 여기서 모두 불러옵니다.
# 사이트 파일 안의 명명 matcher는 사이트 블록 안에서만 유효하므로 이름이 겹쳐도 되지만, 읽기 쉽게 사이트 접두사를 붙입니다.
{
	# reload·종료 때 기존 연결을 최대 10초 기다린 뒤 닫습니다(기본은 무기한).
	grace_period 10s

	servers {
		# 도메인은 Cloudflare 프록시(주황 구름) 뒤에 있습니다(사용자 결정 2026-10-06).
		# Cloudflare에서 온 요청만 CF-Connecting-IP를 방문자 주소({client_ip})로 믿고, 그 밖의 요청은 접속한 주소를 씁니다.
		# 목록 원본: https://www.cloudflare.com/ips-v4 , https://www.cloudflare.com/ips-v6 (확인일 2026-10-06). 바뀌면 이 줄을 갱신합니다.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

import /etc/caddy/sites/*.caddy
