# 서버 /opt/edge/.env 형식(Git 제외, 권한 600). 실제 값은 저장소에 두지 않습니다. 절차: infra/docs/prod-runbook.md
# 값을 바꾸면 /opt/edge에서 docker compose up -d로 Caddy 컨테이너를 다시 만듭니다(reload로는 환경변수가 바뀌지 않음).

# 크리링 단축·API 공개 호스트(sites/crelink.caddy의 사이트 주소). 비우면 go.shaul.kr. 웹 SHORT_LINK_BASE_URL·Vercel API_INTERNAL_URL·DNS와 함께 바꿉니다.
CRELINK_DOMAIN=go.shaul.kr
# 크리링 웹(Vercel)이 서버 측 /api 호출에 붙이는 X-Crelink-Internal 값. Vercel API_INTERNAL_TOKEN과 같아야 합니다. 필수.
# 만드는 법: openssl rand -hex 32
CRELINK_INTERNAL_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
