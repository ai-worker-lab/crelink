# 크리링 단축·API 호스트 공개 정책(edge Caddy 사이트 파일). 기준: docs/specs/crelink-prod-deploy.md "Caddy 공개 정책".
# deploy.sh가 API 헬스 통과 뒤 /opt/edge/sites/crelink.caddy로 복사하고 edge Caddy를 reload합니다(내용이 바뀐 경우만).
# - {$CRELINK_DOMAIN}: 설정을 읽을 때 edge 컨테이너 환경변수로 바뀝니다(기본 go.shaul.kr). 도메인이면 인증서를 자동으로 받고 80→443으로 보냅니다.
# - 공개: GET /{slug}, GET /c/{linkPublicId}. /api/*는 X-Crelink-Internal이 CRELINK_INTERNAL_TOKEN과 같을 때만. 나머지 404.
# - X-Forwarded-For: 업스트림에는 방문자 주소 하나({client_ip})만 보냅니다. Cloudflare에서 온 요청이면 CF-Connecting-IP,
#   아니면 접속한 주소입니다(edge/Caddyfile의 trusted_proxies). 클라이언트가 보낸 X-Forwarded-For는 버려집니다. API는 TRUSTED_PROXY_HOPS=1.
# - 접근 로그(log)는 켜지 않습니다. 켤 때는 X-Crelink-Internal 요청 헤더를 로그 필터로 지워야 합니다.
{$CRELINK_DOMAIN:go.shaul.kr} {
	# 단축 주소. 규칙 원본은 packages/shared/src/crelink.ts의 SLUG_PATTERN(영소문자·숫자·하이픈, 양끝 하이픈 불가)과
	# CRELINK_LIMITS.slugMinLength·slugMaxLength(3~30). API가 slug를 소문자로 바꿔 찾으므로 대문자도 통과시킵니다.
	@crelink_shortlink {
		method GET
		path_regexp ^/[A-Za-z0-9][A-Za-z0-9-]{1,28}[A-Za-z0-9]$
	}

	# 링크 클릭. 링크 public_id는 [a-z0-9] 10자(apps/api/src/creator/links.service.ts LINK_PUBLIC_ID_LENGTH, common/http.ts ID_ALPHABET).
	@crelink_click {
		method GET
		path_regexp ^/c/[a-z0-9]{10}$
	}

	# 웹(Vercel) 서버 측 호출. 토큰이 비어 있으면 어떤 요청도 통과시키지 않습니다.
	# 비교는 CEL 문자열 ==(상수 시간 비교 아님). 한계와 근거: infra/docs/prod-runbook.md "내부 토큰".
	@crelink_internal {
		path /api/*
		expression `{env.CRELINK_INTERNAL_TOKEN} != "" && {header.X-Crelink-Internal} == {env.CRELINK_INTERNAL_TOKEN}`
	}

	handle @crelink_internal {
		reverse_proxy crelink-api:3000 {
			# 토큰을 API까지 보내지 않습니다(API 로그·오류 보고에 남지 않게).
			header_up -X-Crelink-Internal
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle @crelink_click {
		reverse_proxy crelink-api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle @crelink_shortlink {
		reverse_proxy crelink-api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		respond 404
	}
}
