# 크리링 운영 공개 정책(edge 스택 edge/compose.yaml의 caddy). 기준: docs/specs/crelink-prod-deploy.md "공개 경로".
# 경로: 방문자 → Cloudflare(TLS 종료) → cloudflared(서버 호스트) → 127.0.0.1:${CRELINK_HTTP_PORT} → 이 Caddy(http) → 활성 색의 api·web.
# 모든 배포 대상(home-server, 나중의 OCI·AWS)이 이 파일을 그대로 씁니다. 대상별 값은 환경변수뿐입니다.
# 서버에서는 배포·롤백마다 lib.sh가 이 파일을 /opt/crelink/edge/conf/Caddyfile로, 활성 색 업스트림을 같은 폴더의 upstreams.caddy로
# 바꾸고 caddy validate → caddy reload 합니다(Caddy를 다시 만들지 않음). upstreams.caddy 형식(색만 다름, lib.sh write_upstreams):
#   (api_upstream) {
#   	to api-blue:3000
#   }
#   (web_upstream) {
#   	to web-blue:3000
#   }
#
# - 방문자 IP: 이 Caddy에 직접 붙는 것은 같은 호스트의 cloudflared뿐입니다(edge compose가 포트를 127.0.0.1에만 엶). 그래서 사설 대역에서 온
#   요청의 CF-Connecting-IP를 믿고, 업스트림에는 X-Forwarded-For로 방문자 주소 하나({client_ip})만 보냅니다(API TRUSTED_PROXY_HOPS=1).
#   클라이언트가 보낸 X-Forwarded-For는 버려집니다. 이 포트를 공인 주소에 열면 CF-Connecting-IP를 위조할 수 있으므로 열지 않습니다.
#   edge 네트워크의 다른 컨테이너(두 색의 api·web)도 사설 대역이지만 이 Caddy를 부르지 않습니다(web은 같은 색 api를 바로 부름).
# - 관리 API(admin)는 컨테이너 안 localhost:2019에서만 엽니다(reload용, 호스트·네트워크에 열지 않음).
# - reload·정지 때 옛 설정의 진행 중 요청은 최대 30초(grace_period) 마저 처리합니다. 업스트림 연결이 실패하면 10초까지 다시 시도합니다
#   (lb_try_duration, 안전망. 전환은 새 색이 헬스를 통과한 뒤라 평소에는 쓰이지 않음).
# - 업스트림 keep-alive 연결은 4초 쓰지 않으면 닫습니다(transport http keepalive). api·web(Node)은 5초(keepAliveTimeout) 뒤 먼저 닫는데,
#   그보다 오래 두면 Node가 닫는 순간 그 연결로 보낸 요청이 502가 될 수 있고, 전환 뒤 옛 색에 남은 연결(한 번도 쓰지 않은 연결 포함) 때문에
#   옛 색 web이 SIGTERM에 끝나지 못해 30초 뒤 SIGKILL로 정지됩니다(0035 tests/zero-downtime.sh에서 확인, Caddy 기본은 2분).
# - 업스트림은 색 별칭(api-<색>·web-<색>)만 씁니다. 색 없는 api·web은 두 색이 함께 떠 있을 때 양쪽으로 풀립니다.
# - 접근 로그(log)는 켜지 않습니다.
{
	admin localhost:2019
	grace_period 30s
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

# 활성 색 업스트림 스니펫(api_upstream·web_upstream). 이 파일과 같은 폴더의 파일입니다.
import upstreams.caddy

# 단축·클릭 호스트. API는 이 두 경로만 공개합니다. /api/*를 포함한 나머지는 404(웹은 내부 네트워크로 API를 부름).
http://{$CRELINK_SHORT_HOST:go.shaul.kr} {
	# 단축 주소. 규칙 원본은 packages/shared/src/crelink.ts의 SLUG_PATTERN(영소문자·숫자·하이픈, 양끝 하이픈 불가)과
	# CRELINK_LIMITS.slugMinLength·slugMaxLength(3~30). API가 slug를 소문자로 바꿔 찾으므로 대문자도 통과시킵니다.
	@shortlink {
		method GET
		path_regexp ^/[A-Za-z0-9][A-Za-z0-9-]{1,28}[A-Za-z0-9]$
	}

	# 링크 클릭. 링크 public_id는 [a-z0-9] 10자(apps/api/src/creator/links.service.ts LINK_PUBLIC_ID_LENGTH, common/http.ts ID_ALPHABET).
	@click {
		method GET
		path_regexp ^/c/[a-z0-9]{10}$
	}

	handle @click {
		reverse_proxy {
			import api_upstream
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 10s
			transport http {
				keepalive 4s
			}
		}
	}

	handle @shortlink {
		reverse_proxy {
			import api_upstream
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 10s
			transport http {
				keepalive 4s
			}
		}
	}

	handle {
		respond 404
	}
}

# 본 도메인(웹). 브라우저의 API 호출은 웹 BFF(/api/backend)가 내부 네트워크로 같은 색 API에 넘깁니다.
http://{$CRELINK_WEB_HOST:links.shaul.kr} {
	# 이미지 업로드 한도(CRELINK_LIMITS.imageMaxBytes 4MB)에 multipart 여유를 더한 값. 넘으면 413.
	request_body {
		max_size 6MB
	}
	reverse_proxy {
		import web_upstream
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 10s
		transport http {
			keepalive 4s
		}
	}
}

# 컨테이너 헬스체크 전용(호스트에 열지 않음).
http://:2020 {
	respond /healthz "ok" 200
}
